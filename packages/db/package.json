{
  "name": "@avero/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@avero/contracts": "workspace:*",
    "@avero/security": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  },
  "nx": {
    "tags": [
      "scope:shared",
      "type:data-access",
      "runtime:node"
    ],
    "targets": {
      "db:generate": {
        "dependsOn": [
          "^build"
        ],
        "cache": false
      },
      "db:migrate": {
        "cache": false
      },
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
