# Optional when using each SDK's browser sign-in. Set locally or inject in CI.
CURSOR_API_KEY=
# Optional override for the TypeScript SDK prototype.
AVERO_CURSOR_MODEL=composer-2.5
AVERO_WORKER_PORT=3101

# Clerk development application keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AVERO_APP_URL=http://localhost:3000

# Defaults for the local Docker services.
DATABASE_URL=postgresql://avero:avero-local@127.0.0.1:55432/avero
REDIS_URL=redis://127.0.0.1:56379

# Optional overrides for the local Docker services.
AVERO_POSTGRES_PORT=55432
AVERO_POSTGRES_PASSWORD=avero-local
AVERO_REDIS_PORT=56379

# Hosted tasks. Folders the worker may run tasks in (separated by ; on Windows, : elsewhere).
AVERO_REPOSITORY_ROOTS=
# AVERO_WORKER_CONCURRENCY=2
# Cursor sandbox: on (default) or off. It is unsupported on some machines (Windows), where it must be off.
# AVERO_WORKER_SANDBOX=on
# The command guard is on by default; set to off only for a trusted machine.
# AVERO_WORKER_GUARD=on

# GitHub App (all five, or GitHub stays off).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_STATE_SECRET=

# Real-service tests (skipped when unset).
# AVERO_TEST_DATABASE_URL=postgresql://avero:avero-local@127.0.0.1:55432/avero
# AVERO_TEST_REDIS_URL=redis://127.0.0.1:56379
