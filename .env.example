# Optional when using each SDK's browser sign-in. Set locally or inject in CI.
CURSOR_API_KEY=
# Optional override for the TypeScript SDK prototype.
AVERO_CURSOR_MODEL=composer-2.5
AVERO_WORKER_PORT=3101

# Clerk development application keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AVERO_APP_URL=http://localhost:3000

# Defaults for the local Docker services.
DATABASE_URL=postgresql://avero:avero-local@127.0.0.1:55432/avero
REDIS_URL=redis://127.0.0.1:56379

# Optional overrides for the local Docker services.
AVERO_POSTGRES_PORT=55432
AVERO_POSTGRES_PASSWORD=avero-local
AVERO_REDIS_PORT=56379
