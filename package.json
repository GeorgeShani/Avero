{
  "name": "avero",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "check": "nx run-many -t lint typecheck test build",
    "verify:workspace": "node tools/scripts/verify-workspace.mjs",
    "verify:sdk": "node tools/scripts/verify-sdk.mjs",
    "avero": "node tools/scripts/avero.mjs",
    "infra:up": "docker compose --project-directory . -f infra/docker-compose.yml up -d --wait --wait-timeout 90",
    "infra:down": "docker compose --project-directory . -f infra/docker-compose.yml down",
    "infra:verify": "node tools/scripts/verify-infra.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/next": "24.0.6",
    "@nx/node": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.6",
    "nx": "24.0.6",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  }
}
