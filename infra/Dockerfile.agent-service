# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS build
WORKDIR /workspace
RUN npm install --global pnpm@12.21.0
COPY . .
RUN --mount=type=cache,id=avero-pnpm,target=/pnpm/store pnpm install --frozen-lockfile --store-dir /pnpm/store
ENV NX_DAEMON=false
RUN pnpm exec nx build @avero/agent-service
RUN --mount=type=cache,id=avero-pnpm,target=/pnpm/store pnpm --filter @avero/agent-service deploy --legacy --prod --store-dir /pnpm/store /deploy

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production AVERO_AGENT_PORT=3102
COPY --from=build --chown=node:node /deploy ./
# The server keeps its state (sessions, memory) under /data, which a deployment mounts as a volume.
RUN mkdir -p /data && chown node:node /app /data
USER node
EXPOSE 3102
# /v1/info needs the bearer token like every other route, so the probe sends it.
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s CMD ["node", "-e", "fetch('http://127.0.0.1:'+process.env.AVERO_AGENT_PORT+'/v1/info',{headers:{authorization:'Bearer '+process.env.AVERO_AGENT_TOKEN}}).then(r=>{if(!r.ok)process.exitCode=1}).catch(()=>{process.exitCode=1})"]
# Refuses to start without a token: an agent server with no authentication is open to anyone who can reach it.
CMD ["sh", "-c", ": \"${AVERO_AGENT_TOKEN:?AVERO_AGENT_TOKEN must be set}\" && exec node_modules/.bin/agent-sdk serve --dir . --mode single --host 0.0.0.0 --port \"${AVERO_AGENT_PORT}\" --bearer-token \"${AVERO_AGENT_TOKEN}\" --state-root /data/state --no-playground --no-docs"]
